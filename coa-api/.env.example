# OpenRouter: the only external call. Never commit the real key.
OPENROUTER_API_KEY=sk-or-...
# Must support tool calling and image input.
OPENROUTER_MODEL=openai/gpt-4.1
# Optional: a different model for read_coa. Defaults to OPENROUTER_MODEL.
# EXTRACTION_MODEL=openai/gpt-4.1

# Most tool calls one run may make; the router goes to force_submit (REVIEW).
TOOL_BUDGET=12

# Where trace.db, checkpoints.db and uploads/ live.
STATE_DIR=state
