{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "coa-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "fastapi", "dev", "main.py", "--port", "8100"],
      "cwd": "coa-api",
      "port": 8100
    },
    {
      "name": "coa-ui",
      "runtimeExecutable": "env",
      "runtimeArgs": ["API_BASE_URL=http://localhost:8100", "yarn", "dev", "--port", "3100"],
      "cwd": "coa-ui",
      "port": 3100
    }
  ]
}
